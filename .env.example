# Add your model credentials. Chat is unavailable until a working LLM is configured.
MODEL_API_KEY=
MODEL_NAME=
MODEL_BASE_URL=

# Mock email approval: default (pending -> approved) or timeout.
DEMO_EMAIL_SCENARIO=default

# Server-enforced identity verification lifetime and per-session cooldown.
VERIFICATION_IDLE_SECONDS=900
VERIFICATION_MAX_AGE_SECONDS=3600
VERIFICATION_MAX_FAILURES=5
VERIFICATION_LOCK_SECONDS=900

# Encrypted local conversation storage (single worker).
MEMORY_BACKEND=sqlite
# Default directory is <project>/data; Docker should mount /app/data as a volume.
# MEMORY_DATA_DIR=/app/data
# Optional Fernet key; blank creates data/memory.key with owner-only permissions.
# Keep the same key across restarts. Use a separately managed secret in production.
MEMORY_ENCRYPTION_KEY=
MEMORY_RETENTION_SECONDS=86400
MEMORY_MAX_MESSAGES=20
MEMORY_MAX_CHECKPOINTS=30
